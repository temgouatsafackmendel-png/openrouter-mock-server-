# ============================================================================
# OpenRouter Mock & Test Server - Configuration (.env.example)
# ============================================================================

# Port d'écoute du serveur (par défaut: 3000)
PORT=3000

# Configuration Chaos globale par défaut (peut être surchargée par requête via headers HTTP)
MOCK_DEFAULT_LATENCY_MS=0
MOCK_DEFAULT_ERROR_CODE=0
MOCK_FAILURE_PROBABILITY=0.0
MOCK_STREAM_CHUNK_DELAY_MS=35

# Journalisation détaillée dans le terminal (true / false)
MOCK_VERBOSE_LOGGING=true

# Variables environnement plateforme
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
